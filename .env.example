# Ollama may run on localhost, another machine, or the Windows host when using WSL.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=120

# Blender MCP socket endpoint.
A360VG_MCP_HOST=127.0.0.1
A360VG_MCP_PORT=9876
A360VG_MCP_MESSAGE_FORMAT=execute_code
A360VG_ASSET_EXECUTOR=blender_mcp_direct
A360VG_MAX_AUTORUNS=10
A360VG_FLOOR_MODE=checker
